# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173

# Uniform Video Settings (Applied automatically to all downloads)
# Formats: mp4 | mp3 | m4a | webm
DOWNLOAD_FORMAT=mp4
# Qualities: best | 1080p | 720p | 480p | audio
DOWNLOAD_QUALITY=best

# Storage and Cache Settings
DOWNLOAD_STORAGE_DIR=./downloads
CACHE_RETENTION_MINUTES=30
MAX_VIDEO_DURATION_SECONDS=10800
MAX_CONCURRENT_DOWNLOADS=5

# Optional: YouTube Cookies (Paste Netscape cookies.txt content if YouTube blocks host IP)
# YOUTUBE_COOKIES=
# Optional: Proxy (e.g. http://user:pass@host:port)
# YOUTUBE_PROXY=
# Optional: Player Client override (e.g. android, web, default)
# YOUTUBE_PLAYER_CLIENT=
# Optional: Raw extractor args override
# YOUTUBE_EXTRACTOR_ARGS=
# Cloudflare WARP egress (wgcf + wireproxy; enabled by default in the Docker image)
# WARP_ENABLED=false
# WARP_SOCKS_PORT=40000
# WARP_ROTATE_COOLDOWN_SECONDS=300
# Cache video metadata to cut repeat YouTube requests
# INFO_CACHE_MINUTES=300
# HMAC secret for signed /api/video/stream tokens (random per process if unset)
# STREAM_TOKEN_SECRET=
