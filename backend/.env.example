# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173

# Uniform Video Settings (Applied automatically to all downloads)
# Formats: mp4 | mp3 | m4a | webm
DOWNLOAD_FORMAT=mp4
# Qualities: best | 1080p | 720p | 480p | audio
DOWNLOAD_QUALITY=best

# Storage and Cache Settings
DOWNLOAD_STORAGE_DIR=./downloads
CACHE_RETENTION_MINUTES=30
MAX_VIDEO_DURATION_SECONDS=10800
MAX_CONCURRENT_DOWNLOADS=5

# Optional: YouTube Cookies (Paste Netscape cookies.txt content if YouTube blocks host IP)
# YOUTUBE_COOKIES=
# Optional: Proxy (e.g. http://user:pass@host:port)
# YOUTUBE_PROXY=
